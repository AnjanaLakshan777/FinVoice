# FinVoice environment variables.
# Copy this file to `.env` and replace the placeholders:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials or API keys.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=finvoice
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=finvoice
# Host port PostgreSQL is published on (bound to 127.0.0.1).
POSTGRES_PORT=5432
# PostgreSQL connection URL for the backend API and Prisma CLI (migrations, seed).
# Keep user and password in sync with the POSTGRES_* values above. Never log this value.
DATABASE_URL=postgresql://finvoice:change-me-local-only@localhost:5432/finvoice

# ---------------------------------------------------------------------------
# Backend API (apps/api)
# ---------------------------------------------------------------------------
# Use 0.0.0.0 inside containers; 127.0.0.1 keeps local development private.
API_HOST=127.0.0.1
API_PORT=4000

# ---------------------------------------------------------------------------
# Voice gateway (apps/voice-gateway)
# ---------------------------------------------------------------------------
VOICE_GATEWAY_HOST=127.0.0.1
VOICE_GATEWAY_PORT=4100
# Exact browser origins allowed to open voice WebSockets, comma-separated. Never "*".
VOICE_WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Maximum concurrent browser voice connections.
VOICE_MAX_SESSIONS=10
# Gemini Live model for real-time voice (uses GEMINI_API_KEY below, on the gateway only).
GEMINI_LIVE_MODEL=gemini-3.8-live
# Gemini Live prebuilt voice FinVoice speaks with (server-controlled; browsers cannot choose it).
GEMINI_LIVE_VOICE=Kore
# Base URL of the API, for the gateway's internal calls (session setup and tools).
INTERNAL_API_URL=http://127.0.0.1:4000
# Shared secret between the API and the voice gateway (at least 32 characters). Server-side
# only: never put it in NEXT_PUBLIC_* variables. Leave empty to disable voice (sessions then
# fail with VOICE_CONFIG_ERROR). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# AI agent (apps/api) and voice (apps/voice-gateway): Google Gemini
# ---------------------------------------------------------------------------
# Server-side only (API and voice gateway). Never put this key in web/browser code or any
# NEXT_PUBLIC_* variable, and never commit a real key. Leave empty to run without the agent
# (POST /api/v1/agent/chat → 503) and without voice (VOICE_CONFIG_ERROR).
GEMINI_API_KEY=
# Model used by the text agent.
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Web app (apps/web)
# ---------------------------------------------------------------------------
# Public WebSocket URL of the voice gateway, used by the browser (not a secret). Next.js reads
# NEXT_PUBLIC_* variables from apps/web/.env.local or the environment, not from this root file.
# When unset, the web app uses ws://127.0.0.1:4100/voice.
NEXT_PUBLIC_VOICE_GATEWAY_URL=ws://127.0.0.1:4100/voice
