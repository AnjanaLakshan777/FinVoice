# FinVoice environment variables.
# Copy this file to `.env` and replace the placeholders:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials or API keys.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=finvoice
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=finvoice
# Host port PostgreSQL is published on (bound to 127.0.0.1).
POSTGRES_PORT=5432
# PostgreSQL connection URL for the backend API and Prisma CLI (migrations, seed).
# Keep user and password in sync with the POSTGRES_* values above. Never log this value.
DATABASE_URL=postgresql://finvoice:change-me-local-only@localhost:5432/finvoice

# ---------------------------------------------------------------------------
# Backend API (apps/api)
# ---------------------------------------------------------------------------
# Use 0.0.0.0 inside containers; 127.0.0.1 keeps local development private.
API_HOST=127.0.0.1
API_PORT=4000
# Days operational analytics events are kept (1-3650). `pnpm analytics:cleanup` deletes older
# events; nothing is deleted automatically at startup.
ANALYTICS_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Authentication (apps/api): phone OTP, JWT access tokens, refresh sessions
# See docs/architecture/authentication-authorization.md.
# ---------------------------------------------------------------------------
# SECRET (server-only): HS256 signing key for access tokens. At least 43 characters (32 random
# bytes). Required in production. Leave empty to disable authentication (sign-in and all
# signed-in routes then answer 503). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=
# SECRET (server-only): pepper for OTP hashes. At least 43 characters, generated separately; must
# differ from AUTH_JWT_SECRET and INTERNAL_API_TOKEN. Required in production.
AUTH_OTP_PEPPER=
# Access token lifetime (60-3600 s) and refresh session lifetime (1-90 days).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# OTP: validity (60-1800 s), attempts per code (1-10), and requests per phone number per window.
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_REQUEST_LIMIT=3
AUTH_OTP_REQUEST_WINDOW_SECONDS=900
# OTP delivery. Empty: none (sign-in answers 503). "dev": DEVELOPMENT/TEST ONLY. Every code is
# AUTH_OTP_DEV_CODE and nothing is sent. Startup fails if either is set unless NODE_ENV is exactly
# "development" or "test" (never staging, preview or production; not when NODE_ENV is unset). No
# real SMS provider exists yet; one is required before any production deployment. For local sign-in set AUTH_OTP_PROVIDER=dev and choose your own 8-digit
# development-only code below (never a real secret, never committed).
AUTH_OTP_PROVIDER=
AUTH_OTP_DEV_CODE=
# HttpOnly refresh-token cookie (Path=/api/v1/auth, SameSite=Lax). Secure defaults to true in
# production, where false is rejected; false is needed for plain http://localhost.
AUTH_REFRESH_COOKIE_NAME=finvoice_refresh
AUTH_REFRESH_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Voice gateway (apps/voice-gateway)
# ---------------------------------------------------------------------------
VOICE_GATEWAY_HOST=127.0.0.1
VOICE_GATEWAY_PORT=4100
# Exact browser origins allowed to open voice WebSockets, comma-separated. Never "*".
VOICE_WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Maximum concurrent browser voice connections.
VOICE_MAX_SESSIONS=10
# Gemini Live model for real-time voice (uses GEMINI_API_KEY below, on the gateway only).
GEMINI_LIVE_MODEL=gemini-3.8-live
# Gemini Live prebuilt voice FinVoice speaks with (server-controlled; browsers cannot choose it).
GEMINI_LIVE_VOICE=Kore
# Base URL of the API, for server-side internal calls: the voice gateway (session setup, tools,
# session analytics) and the web server's admin dashboard. Never exposed to browsers.
INTERNAL_API_URL=http://127.0.0.1:4000
# Shared secret for the API's INTERNAL endpoints (/internal/*): used by the voice gateway and by
# trusted services reading personal financial context (at least 32 characters). It identifies a
# FinVoice SERVICE, never a person, and is separate from the AUTH_* secrets (it must differ from
# them). Server-side only: never put it in NEXT_PUBLIC_* variables, and never reuse the Gemini
# key. Leave empty to disable
# the internal endpoints (voice sessions then fail with VOICE_CONFIG_ERROR). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# AI agent (apps/api) and voice (apps/voice-gateway): Google Gemini
# ---------------------------------------------------------------------------
# Server-side only (API and voice gateway). Never put this key in web/browser code or any
# NEXT_PUBLIC_* variable, and never commit a real key. Leave empty to run without the agent
# (POST /api/v1/agent/chat → 503) and without voice (VOICE_CONFIG_ERROR).
GEMINI_API_KEY=
# Model used by the text agent.
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Web app (apps/web)
# ---------------------------------------------------------------------------
# Temporary admin dashboard (http://localhost:3000/admin): aggregate analytics only. DISABLED unless
# "true". The web app does not sign users in yet (API authentication exists since Step 11, but the
# dashboard is not connected to it), so the dashboard has no login: enable it only for local
# development or a trusted internal network. The web SERVER calls the API's internal endpoints with INTERNAL_API_TOKEN; the
# token never reaches the browser. Never put these in NEXT_PUBLIC_* variables.
ADMIN_DASHBOARD_ENABLED=false

# Public WebSocket URL of the voice gateway, used by the browser (not a secret). Next.js reads
# NEXT_PUBLIC_* variables from apps/web/.env.local or the environment, not from this root file.
# When unset, the web app uses ws://127.0.0.1:4100/voice.
NEXT_PUBLIC_VOICE_GATEWAY_URL=ws://127.0.0.1:4100/voice
