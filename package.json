{
  "name": "finvoice",
  "version": "0.0.0",
  "private": true,
  "description": "Voice-first financial inclusion and financial literacy platform for Sri Lanka.",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/**\" dev",
    "dev:web": "pnpm build:packages && pnpm --filter @finvoice/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @finvoice/api dev",
    "dev:voice-gateway": "pnpm build:packages && pnpm --filter @finvoice/voice-gateway dev",
    "typecheck": "pnpm build:packages && pnpm --recursive typecheck",
    "lint": "pnpm build:packages && eslint .",
    "lint:fix": "pnpm build:packages && eslint . --fix",
    "test": "pnpm build:packages && pnpm --recursive --if-present test",
    "test:integration": "pnpm build:packages && pnpm --filter @finvoice/api test:integration",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "pnpm --recursive run clean",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres",
    "db:migrate": "pnpm --filter @finvoice/api db:migrate",
    "db:migrate:create": "pnpm --filter @finvoice/api db:migrate:create",
    "db:migrate:status": "pnpm --filter @finvoice/api db:migrate:status",
    "db:seed": "pnpm build:packages && pnpm --filter @finvoice/api db:seed",
    "db:seed:knowledge": "pnpm build:packages && pnpm --filter @finvoice/api db:seed:knowledge",
    "analytics:cleanup": "pnpm build:packages && pnpm --filter @finvoice/api analytics:cleanup"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
