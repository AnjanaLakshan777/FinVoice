{
  "name": "@finvoice/web",
  "version": "0.0.0",
  "private": true,
  "description": "FinVoice web application (Next.js).",
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "node --eval \"fs.rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --project tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@finvoice/config": "workspace:*",
    "@finvoice/contracts": "workspace:*",
    "@finvoice/shared": "workspace:*",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
