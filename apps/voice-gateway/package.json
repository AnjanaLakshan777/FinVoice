{
  "name": "@finvoice/voice-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "FinVoice real-time voice gateway service (Node.js).",
  "type": "module",
  "scripts": {
    "build": "pnpm run clean && tsc --project tsconfig.build.json",
    "clean": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "probe:live-text": "tsx --env-file-if-exists=../../.env scripts/live-text-probe.ts"
  },
  "dependencies": {
    "@finvoice/config": "workspace:*",
    "@finvoice/contracts": "workspace:*",
    "@finvoice/shared": "workspace:*",
    "@google/genai": "2.24.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
