{
  "name": "@finvoice/api",
  "version": "0.0.0",
  "private": true,
  "description": "FinVoice backend API (NestJS).",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "clean": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --enable-source-maps\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@finvoice/config": "workspace:*",
    "@finvoice/shared": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.6",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
