// FinVoice database schema.
// Design rationale: docs/architecture/database.md
//
// Changes to this file must be shipped as a migration (`pnpm db:migrate:create --name <change>`).
// CHECK constraints cannot be expressed in Prisma schema; they live in the migration SQL
// and are listed next to each model below.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Languages FinVoice converses in.
enum Language {
  SI // Sinhala
  TA // Tamil
  EN // English

  @@map("language")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

/// Authorization role (Step 11). Assigned only by trusted server-side provisioning, never by a
/// client request. ADMIN does not grant access to other users' personal data.
enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum FinancialGoalType {
  SAVINGS
  EMERGENCY_FUND
  DEBT_REPAYMENT
  OTHER

  @@map("financial_goal_type")
}

enum FinancialGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("financial_goal_status")
}

/// A person using FinVoice, identified by their phone number.
/// CHECK: phone_number is E.164; display_name, if present, is not blank; timezone is not blank.
model User {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// E.164 format, e.g. +94771234567. Unique index also serves phone-number lookups.
  phoneNumber       String     @unique @map("phone_number") @db.VarChar(16)
  displayName       String?    @map("display_name") @db.VarChar(100)
  preferredLanguage Language   @map("preferred_language")
  /// IANA time zone name.
  timezone          String     @default("Asia/Colombo") @db.VarChar(64)
  status            UserStatus @default(ACTIVE)
  role              UserRole   @default(USER)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  financialProfile          FinancialProfile?
  financialGoals            FinancialGoal[]
  financialLiteracyProfile  FinancialLiteracyProfile?
  financialLiteracyProgress FinancialLiteracyTopicProgress[]
  authSessions              AuthSession[]

  @@map("users")
}

/// A user's self-reported monthly finances. At most one per user.
/// CHECK: currency is an ISO 4217 code; monthly amounts are >= 0.
model FinancialProfile {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  /// Null until the user has provided it.
  monthlyIncome   Decimal? @map("monthly_income") @db.Decimal(14, 2)
  /// Null until the user has provided it.
  monthlyExpenses Decimal? @map("monthly_expenses") @db.Decimal(14, 2)
  /// ISO 4217 code; applies to every amount on this profile.
  currency        String   @default("LKR") @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("financial_profiles")
}

/// Something a user is saving towards or paying off.
/// CHECK: name is not blank; currency is an ISO 4217 code; target_amount > 0;
///        0 <= current_amount <= target_amount.
model FinancialGoal {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  type          FinancialGoalType
  name          String              @db.VarChar(120)
  targetAmount  Decimal             @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal             @default(0) @map("current_amount") @db.Decimal(14, 2)
  /// ISO 4217 code; applies to target_amount and current_amount.
  currency      String              @default("LKR") @db.Char(3)
  targetDate    DateTime?           @map("target_date") @db.Date
  status        FinancialGoalStatus @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// "A user's goals" and "a user's goals with status X, by target date". Also indexes the FK.
  @@index([userId, status, targetDate])
  /// "Active goals due before date D" across all users (reminders, follow-ups).
  @@index([status, targetDate])
  @@map("financial_goals")
}

// ---------------------------------------------------------------------------
// Financial knowledge base (docs/architecture/financial-knowledge-base.md)
// ---------------------------------------------------------------------------

enum KnowledgeSourceType {
  OFFICIAL_GOVERNMENT
  OFFICIAL_REGULATOR
  OFFICIAL_FINANCIAL_INSTITUTION
  EDUCATIONAL
  OTHER

  @@map("knowledge_source_type")
}

enum KnowledgeCategory {
  SAVING
  BUDGETING
  BORROWING
  DIGITAL_FINANCE
  CONSUMER_PROTECTION
  SCAMS
  DEPOSIT_PROTECTION
  GENERAL_FINANCIAL_LITERACY

  @@map("knowledge_category")
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("knowledge_article_status")
}

enum KnowledgeAudience {
  GENERAL_PUBLIC
  YOUNG_ADULT
  LOW_DIGITAL_LITERACY
  SMALL_BUSINESS
  OTHER

  @@map("knowledge_audience")
}

/// How a translation was produced. Only OFFICIAL may be presented as the source's own wording.
enum KnowledgeTranslationStatus {
  OFFICIAL
  HUMAN_REVIEWED
  MACHINE_ASSISTED

  @@map("knowledge_translation_status")
}

/// A document or web page that knowledge articles are based on.
/// CHECK: url is https; publisher and title are not blank; next_review_at > last_verified_at.
model KnowledgeSource {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publisher        String              @db.VarChar(200)
  title            String              @db.VarChar(300)
  /// The citation link. Unique, so one document is recorded once and shared by its articles.
  url              String              @unique @db.VarChar(2048)
  sourceType       KnowledgeSourceType @map("source_type")
  originalLanguage Language            @map("original_language")
  /// Publication date stated by the source, if known.
  publishedOn      DateTime?           @map("published_on") @db.Date
  /// When FinVoice retrieved the content the articles are based on.
  retrievedAt      DateTime            @map("retrieved_at") @db.Timestamptz(3)
  /// When a person last confirmed the source still says what the articles say.
  lastVerifiedAt   DateTime            @map("last_verified_at") @db.Timestamptz(3)
  nextReviewAt     DateTime            @map("next_review_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  articles KnowledgeArticle[]

  @@map("knowledge_sources")
}

/// A piece of financial-literacy knowledge, backed by a source. Its text lives in translations;
/// English is the canonical language.
/// CHECK: slug is kebab-case; a PUBLISHED article has a source; a time-sensitive article has
///        review dates; next_review_at > last_reviewed_at.
model KnowledgeArticle {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable public identifier, e.g. "responsible-borrowing". Unique index serves lookups by slug.
  slug            String                 @unique @db.VarChar(100)
  category        KnowledgeCategory
  status          KnowledgeArticleStatus @default(DRAFT)
  audience        KnowledgeAudience      @default(GENERAL_PUBLIC)
  /// Required once PUBLISHED (CHECK); a draft may not have one yet.
  sourceId        String?                @map("source_id") @db.Uuid
  /// Where in the source the content comes from, e.g. a chapter or page range.
  sourceSection   String?                @map("source_section") @db.VarChar(300)
  /// True for facts that can change (limits, amounts, rules, contact details).
  isTimeSensitive Boolean                @default(false) @map("is_time_sensitive")
  lastReviewedAt  DateTime?              @map("last_reviewed_at") @db.Timestamptz(3)
  nextReviewAt    DateTime?              @map("next_review_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// A source cannot be deleted while articles cite it.
  source       KnowledgeSource?              @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  translations KnowledgeArticleTranslation[]

  /// "Published articles, optionally in one category" (list and category endpoints).
  @@index([status, category])
  /// Indexes the foreign key: deleting or checking a source must not scan every article.
  @@index([sourceId])
  @@map("knowledge_articles")
}

/// The text of an article in one language. At most one per article and language.
/// CHECK: title, summary and body are not blank.
model KnowledgeArticleTranslation {
  id                String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  articleId         String                     @map("article_id") @db.Uuid
  language          Language
  title             String                     @db.VarChar(200)
  summary           String                     @db.VarChar(500)
  body              String
  /// Lower-case search terms, matched exactly by the lexical search.
  keywords          String[]                   @default([])
  translationStatus KnowledgeTranslationStatus @map("translation_status")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Translations belong to their article and are removed with it.
  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// One translation per language; its index also serves "the translations of an article".
  @@unique([articleId, language])
  @@map("knowledge_article_translations")
}

// ---------------------------------------------------------------------------------------------
// Financial literacy (Step 8). See docs/architecture/personal-financial-context.md.
// ---------------------------------------------------------------------------------------------

/// A learning level, not a rating of intelligence or competence. Changed only by explicit
/// application logic (a formal assessment or an authorised update), never inferred from chats.
enum FinancialLiteracyLevel {
  BEGINNER
  DEVELOPING
  CONFIDENT

  @@map("financial_literacy_level")
}

enum FinancialLiteracyTopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("financial_literacy_topic_status")
}

/// The user's financial-literacy learning level. assessedAt null means "no formal assessment
/// completed yet": creating the row does not set it.
model FinancialLiteracyProfile {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String                 @unique @map("user_id") @db.Uuid
  level             FinancialLiteracyLevel @default(BEGINNER)
  assessmentVersion String                 @default("1") @map("assessment_version") @db.VarChar(20)
  assessedAt        DateTime?              @map("assessed_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("financial_literacy_profiles")
}

/// The user's progress on one literacy topic. Topics are the knowledge-base categories; progress
/// is per topic, not per article, because articles change over time. No row means NOT_STARTED.
model FinancialLiteracyTopicProgress {
  id             String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String                       @map("user_id") @db.Uuid
  topic          KnowledgeCategory
  status         FinancialLiteracyTopicStatus @default(NOT_STARTED)
  startedAt      DateTime?                    @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?                    @map("completed_at") @db.Timestamptz(3)
  lastActivityAt DateTime?                    @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  // Also serves "all progress of a user" (user_id is its leading column): no separate index.
  @@unique([userId, topic])
  @@map("financial_literacy_topic_progress")
}

// ---------------------------------------------------------------------------------------------
// Analytics (Step 10). See docs/architecture/analytics.md.
//
// Operational metadata only: which kind of operation happened, in which language and category,
// whether it worked and how long it took. There is deliberately no user id, no free-text field and
// no JSON metadata column, so content (messages, transcripts, amounts, credentials, ScamShield
// content, search queries, tool arguments or results) cannot be stored even by mistake.
// ---------------------------------------------------------------------------------------------

/// One kind of operational occurrence each.
enum AnalyticsEventType {
  AGENT_REQUEST
  AGENT_TOOL_CALL
  VOICE_SESSION
  VOICE_TOOL_CALL
  KNOWLEDGE_SEARCH
  KNOWLEDGE_ARTICLE_VIEW
  SCAM_ANALYSIS
  LITERACY_TOPIC_STARTED
  LITERACY_TOPIC_COMPLETED
  CALCULATION

  @@map("analytics_event_type")
}

/// The channel the operation came through.
enum AnalyticsEventSource {
  WEB
  VOICE
  API
  INTERNAL

  @@map("analytics_event_source")
}

/// The tool or calculator used: names only, never arguments or results.
enum AnalyticsToolName {
  search_knowledge
  get_knowledge_article
  calculate_loan
  calculate_savings
  calculate_budget
  get_user_financial_context
  get_user_literacy_context

  @@map("analytics_tool_name")
}

/// ScamShield's final indicator-based risk level (no content, no evidence).
enum ScamRiskLevel {
  INSUFFICIENT_INFORMATION
  LOW
  MEDIUM
  HIGH

  @@map("scam_risk_level")
}

/// The kind of content the user said they checked with ScamShield.
enum ScamSourceType {
  MESSAGE
  EMAIL
  CALL
  SOCIAL_MEDIA
  WEBSITE
  OFFER
  UNKNOWN

  @@map("scam_source_type")
}

/// Controlled failure codes: never free-text messages, stack traces or provider errors.
enum AnalyticsErrorCode {
  VALIDATION_ERROR
  BAD_REQUEST
  NOT_FOUND
  CONFLICT
  PAYLOAD_TOO_LARGE
  UNSUPPORTED_MEDIA_TYPE
  METHOD_NOT_ALLOWED
  UNAUTHORIZED
  FORBIDDEN
  TOO_MANY_REQUESTS
  BAD_GATEWAY
  SERVICE_UNAVAILABLE
  INTERNAL_ERROR
  VOICE_CONFIG_ERROR
  VOICE_PROVIDER_UNAVAILABLE
  VOICE_SESSION_ERROR
  VOICE_INVALID_MESSAGE
  VOICE_TOOL_ERROR
  VOICE_LIMIT_REACHED
  UNKNOWN_TOOL
  INVALID_ARGUMENTS
  TOOL_FAILED
  TOOL_LIMIT_REACHED

  @@map("analytics_error_code")
}

/// One operational event. occurredAt is set by the API (UTC). Deleted after the retention period
/// by `pnpm analytics:cleanup`. Which optional field may be set for which event type is enforced
/// by CHECK constraints (see the migration).
model AnalyticsEvent {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType         AnalyticsEventType   @map("event_type")
  source            AnalyticsEventSource
  occurredAt        DateTime             @map("occurred_at") @db.Timestamptz(3)
  language          Language?
  knowledgeCategory KnowledgeCategory?   @map("knowledge_category")
  toolName          AnalyticsToolName?   @map("tool_name")
  scamRiskLevel     ScamRiskLevel?       @map("scam_risk_level")
  scamSourceType    ScamSourceType?      @map("scam_source_type")
  success           Boolean
  /// Integer milliseconds, 0 to 24 hours.
  durationMs        Int?                 @map("duration_ms")
  errorCode         AnalyticsErrorCode?  @map("error_code")
  /// A random voice-session id from the gateway: not derived from any identity, never shown.
  sessionId         String?              @map("session_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  // Every dashboard query filters a date range: range scans over all events (overview, languages,
  // health, retention cleanup) ...
  @@index([occurredAt])
  // ... and range scans of one event type (trends and the per-feature sections).
  @@index([eventType, occurredAt])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------------------------
// Authentication (Step 11). See docs/architecture/authentication-authorization.md.
// ---------------------------------------------------------------------------------------------

/// One phone-OTP sign-in attempt. The code itself is never stored: code_hash is
/// HMAC-SHA-256(AUTH_OTP_PEPPER, "<id>:<code>"). No link to users (a challenge must not reveal
/// whether an account exists), no IP address, no user agent, no delivery details.
/// The id is generated by the API (random UUIDv4), because it is part of the hash input.
/// CHECK: phone_number is E.164; code_hash is 64 hex characters; 0 <= attempts <= max_attempts;
/// 1 <= max_attempts <= 20; expires_at > created_at; not both consumed and superseded.
model OtpChallenge {
  id           String    @id @db.Uuid
  phoneNumber  String    @map("phone_number") @db.VarChar(16)
  codeHash     String    @map("code_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  maxAttempts  Int       @map("max_attempts")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)

  // Rate limiting (a phone number's challenges in the last window) and superseding the active
  // challenges of a phone number.
  @@index([phoneNumber, createdAt])
  // Cleanup of expired challenges.
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// One refresh session (one device sign-in, or one link in a rotation chain). The refresh token
/// itself is never stored: refresh_token_hash is its SHA-256. A rotation revokes the row and
/// creates its successor in the same token family; reuse of a revoked token revokes the family.
/// CHECK: refresh_token_hash is 64 hex characters; expires_at > created_at; a replaced session is
/// revoked.
model AuthSession {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @unique @map("refresh_token_hash") @db.Char(64)
  tokenFamilyId       String    @map("token_family_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(3)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  // A user's sessions (and the FK for cascading deletes).
  @@index([userId])
  // Revoking a whole token family on reuse or logout.
  @@index([tokenFamilyId])
  // Cleanup of expired sessions.
  @@index([expiresAt])
  @@map("auth_sessions")
}
