// FinVoice database schema.
// Design rationale: docs/architecture/database.md
//
// Changes to this file must be shipped as a migration (`pnpm db:migrate:create --name <change>`).
// CHECK constraints cannot be expressed in Prisma schema; they live in the migration SQL
// and are listed next to each model below.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Languages FinVoice converses in.
enum Language {
  SI // Sinhala
  TA // Tamil
  EN // English

  @@map("language")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum FinancialGoalType {
  SAVINGS
  EMERGENCY_FUND
  DEBT_REPAYMENT
  OTHER

  @@map("financial_goal_type")
}

enum FinancialGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("financial_goal_status")
}

/// A person using FinVoice, identified by their phone number.
/// CHECK: phone_number is E.164; display_name, if present, is not blank; timezone is not blank.
model User {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// E.164 format, e.g. +94771234567. Unique index also serves phone-number lookups.
  phoneNumber       String     @unique @map("phone_number") @db.VarChar(16)
  displayName       String?    @map("display_name") @db.VarChar(100)
  preferredLanguage Language   @map("preferred_language")
  /// IANA time zone name.
  timezone          String     @default("Asia/Colombo") @db.VarChar(64)
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  financialProfile FinancialProfile?
  financialGoals   FinancialGoal[]

  @@map("users")
}

/// A user's self-reported monthly finances. At most one per user.
/// CHECK: currency is an ISO 4217 code; monthly amounts are >= 0.
model FinancialProfile {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  /// Null until the user has provided it.
  monthlyIncome   Decimal? @map("monthly_income") @db.Decimal(14, 2)
  /// Null until the user has provided it.
  monthlyExpenses Decimal? @map("monthly_expenses") @db.Decimal(14, 2)
  /// ISO 4217 code; applies to every amount on this profile.
  currency        String   @default("LKR") @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("financial_profiles")
}

/// Something a user is saving towards or paying off.
/// CHECK: name is not blank; currency is an ISO 4217 code; target_amount > 0;
///        0 <= current_amount <= target_amount.
model FinancialGoal {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  type          FinancialGoalType
  name          String              @db.VarChar(120)
  targetAmount  Decimal             @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal             @default(0) @map("current_amount") @db.Decimal(14, 2)
  /// ISO 4217 code; applies to target_amount and current_amount.
  currency      String              @default("LKR") @db.Char(3)
  targetDate    DateTime?           @map("target_date") @db.Date
  status        FinancialGoalStatus @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// "A user's goals" and "a user's goals with status X, by target date". Also indexes the FK.
  @@index([userId, status, targetDate])
  /// "Active goals due before date D" across all users (reminders, follow-ups).
  @@index([status, targetDate])
  @@map("financial_goals")
}

// ---------------------------------------------------------------------------
// Financial knowledge base (docs/architecture/financial-knowledge-base.md)
// ---------------------------------------------------------------------------

enum KnowledgeSourceType {
  OFFICIAL_GOVERNMENT
  OFFICIAL_REGULATOR
  OFFICIAL_FINANCIAL_INSTITUTION
  EDUCATIONAL
  OTHER

  @@map("knowledge_source_type")
}

enum KnowledgeCategory {
  SAVING
  BUDGETING
  BORROWING
  DIGITAL_FINANCE
  CONSUMER_PROTECTION
  SCAMS
  DEPOSIT_PROTECTION
  GENERAL_FINANCIAL_LITERACY

  @@map("knowledge_category")
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("knowledge_article_status")
}

enum KnowledgeAudience {
  GENERAL_PUBLIC
  YOUNG_ADULT
  LOW_DIGITAL_LITERACY
  SMALL_BUSINESS
  OTHER

  @@map("knowledge_audience")
}

/// How a translation was produced. Only OFFICIAL may be presented as the source's own wording.
enum KnowledgeTranslationStatus {
  OFFICIAL
  HUMAN_REVIEWED
  MACHINE_ASSISTED

  @@map("knowledge_translation_status")
}

/// A document or web page that knowledge articles are based on.
/// CHECK: url is https; publisher and title are not blank; next_review_at > last_verified_at.
model KnowledgeSource {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publisher        String              @db.VarChar(200)
  title            String              @db.VarChar(300)
  /// The citation link. Unique, so one document is recorded once and shared by its articles.
  url              String              @unique @db.VarChar(2048)
  sourceType       KnowledgeSourceType @map("source_type")
  originalLanguage Language            @map("original_language")
  /// Publication date stated by the source, if known.
  publishedOn      DateTime?           @map("published_on") @db.Date
  /// When FinVoice retrieved the content the articles are based on.
  retrievedAt      DateTime            @map("retrieved_at") @db.Timestamptz(3)
  /// When a person last confirmed the source still says what the articles say.
  lastVerifiedAt   DateTime            @map("last_verified_at") @db.Timestamptz(3)
  nextReviewAt     DateTime            @map("next_review_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  articles KnowledgeArticle[]

  @@map("knowledge_sources")
}

/// A piece of financial-literacy knowledge, backed by a source. Its text lives in translations;
/// English is the canonical language.
/// CHECK: slug is kebab-case; a PUBLISHED article has a source; a time-sensitive article has
///        review dates; next_review_at > last_reviewed_at.
model KnowledgeArticle {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable public identifier, e.g. "responsible-borrowing". Unique index serves lookups by slug.
  slug            String                 @unique @db.VarChar(100)
  category        KnowledgeCategory
  status          KnowledgeArticleStatus @default(DRAFT)
  audience        KnowledgeAudience      @default(GENERAL_PUBLIC)
  /// Required once PUBLISHED (CHECK); a draft may not have one yet.
  sourceId        String?                @map("source_id") @db.Uuid
  /// Where in the source the content comes from, e.g. a chapter or page range.
  sourceSection   String?                @map("source_section") @db.VarChar(300)
  /// True for facts that can change (limits, amounts, rules, contact details).
  isTimeSensitive Boolean                @default(false) @map("is_time_sensitive")
  lastReviewedAt  DateTime?              @map("last_reviewed_at") @db.Timestamptz(3)
  nextReviewAt    DateTime?              @map("next_review_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// A source cannot be deleted while articles cite it.
  source       KnowledgeSource?              @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  translations KnowledgeArticleTranslation[]

  /// "Published articles, optionally in one category" (list and category endpoints).
  @@index([status, category])
  /// Indexes the foreign key: deleting or checking a source must not scan every article.
  @@index([sourceId])
  @@map("knowledge_articles")
}

/// The text of an article in one language. At most one per article and language.
/// CHECK: title, summary and body are not blank.
model KnowledgeArticleTranslation {
  id                String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  articleId         String                     @map("article_id") @db.Uuid
  language          Language
  title             String                     @db.VarChar(200)
  summary           String                     @db.VarChar(500)
  body              String
  /// Lower-case search terms, matched exactly by the lexical search.
  keywords          String[]                   @default([])
  translationStatus KnowledgeTranslationStatus @map("translation_status")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Translations belong to their article and are removed with it.
  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// One translation per language; its index also serves "the translations of an article".
  @@unique([articleId, language])
  @@map("knowledge_article_translations")
}
